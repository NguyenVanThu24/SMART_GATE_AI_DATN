# ===== Camera / web =====
# (RTSP_URL có mật khẩu: đặt trong .smartgate_ai_rtsp.env, không commit lên git)
RTSP_URL=rtsp://user:pass@192.168.1.10:554/H.264
JPEG_QUALITY=80
WEB_WIDTH=960
WEB_HEIGHT=540
STREAM_INTERVAL=0.067
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
CAMERA_RETRY_DELAY=3

# ===== Phát hiện biển số (chạy liên tục để ghim vị trí) =====
AI_INTERVAL=0.1
CONF_BIEN_SO=0.10
NGUONG_PHAT_HIEN_OCR=0
IMGSZ_BIEN_SO=1920
BAT_NHAN_DANG_XE=false

# ===== OCR (chạy đến khi chốt rồi dừng) =====
NGUONG_OCR=0.70
SO_LAN_XAC_NHAN=5
OCR_TOI_DA_MOI_XE=15
OCR_INTERVAL=0.2
OCR_DEVICE=cpu

# ===== Tracking =====
FPS_MUC_TIEU=15
IOU_GHEP_BIEN_SO=0.25
THOI_GIAN_GIU_TRACK=1.0
THOI_GIAN_GIU_DA_CHOT=5

# ===== API =====
AI_API_URL=http://server:3000/api/ai/detect
AI_API_KEY=smartgate-ai-key
GATE_ID=1
MIN_OCR_SCORE=0.70
COOLDOWN=30
API_TIMEOUT=5
DO_DAI_BIEN_MIN=7
DO_DAI_BIEN_MAX=10

# ===== Ảnh / video =====
OUTPUT_DIR=/data
FPS_MAC_DINH_VIDEO=25
